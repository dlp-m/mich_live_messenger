<%# Fenêtre login style Windows Live Messenger %>
<%= render WindowComponent.new(title: t("login_window.title")) do %>

  <div class="relative bg-white px-6 pt-6">

    <div class="absolute inset-x-0 top-0 h-[195px] bg-gradient-to-b from-[#8bbad8] via-[#cce4f6] to-white pointer-events-none"></div>

    <span class="absolute top-3 right-3 w-6 h-6 rounded-full bg-gradient-to-b from-[#5aa0e8] to-[#3a78cc] text-white text-[12px] font-bold flex items-center justify-center cursor-default shadow-[inset_0_1px_0_rgba(255,255,255,0.4),0_1px_3px_rgba(0,0,0,0.3)] border border-[#2860aa]">?</span>

    <div class="relative">

      <div class="mb-5">
        <p class="text-[22px] text-[#2a4a7a] leading-snug"><%= t("login_window.sign_in_to") %></p>
        <p class="leading-snug">
          <span class="text-[22px] font-normal text-[#1a3060]"><%= t("login_window.app_name_prefix") %> </span><span class="text-[28px] font-bold text-[#1a3060]"><%= t("login_window.app_name_suffix") %></span>
        </p>
      </div>

      <div class="flex gap-4 items-start">

        <div class="shrink-0 w-[90px] h-[90px] rounded-xl bg-gradient-to-br from-[#b0e050] via-[#66cc22] to-[#3a9010] p-[5px] shadow-[0_2px_8px_rgba(0,0,0,0.25)]">
          <div class="w-full h-full rounded-lg overflow-hidden">
            <%= image_tag "avatar.webp", alt: "", class: "w-full h-full object-cover" %>
          </div>
        </div>

        <div class="flex-1 min-w-0">
          <%= form_with url: user_session_path, method: :post do |f| %>

            <div class="mb-2">
              <%= text_field_tag "user[email]", nil,
                    id: "user_email", type: "email",
                    autocomplete: "email", autofocus: true, required: true,
                    class: "w-full border border-[#a0a8b0] px-2 py-1 text-sm bg-white shadow-[inset_1px_1px_3px_rgba(0,0,0,0.15)] focus:outline-none focus:border-[#4a80c8]" %>
            </div>

            <div class="mb-1">
              <%= password_field_tag "user[password]", nil,
                    id: "user_password", autocomplete: "current-password", required: true,
                    placeholder: t("login_window.password"),
                    class: "w-full border border-[#a0a8b0] px-2 py-1 text-sm bg-white shadow-[inset_1px_1px_3px_rgba(0,0,0,0.15)] focus:outline-none focus:border-[#4a80c8]" %>
            </div>

            <div class="mb-2">
              <%= link_to t("login_window.forgot_password"), new_user_password_path, class: "text-[12px] text-[#1560c0] hover:underline" %>
            </div>

            <div class="flex items-center gap-1.5 mb-2 text-[12px] text-gray-700">
              <span><%= t("login_window.sign_in_as") %></span>
              <span class="inline-flex items-center gap-1 px-1.5 py-px border border-[#a0a8b0] bg-gradient-to-b from-[#f8f8f8] to-[#e4e4e4] shadow-[inset_0_1px_0_rgba(255,255,255,0.8)] cursor-default">
                <span class="w-2.5 h-2.5 bg-[#22aa22] inline-block rounded-sm"></span>
                <span><%= t("login_window.available") %></span>
                <span class="text-[10px] text-gray-500">▾</span>
              </span>
            </div>

            <div class="space-y-1 text-[12px] text-gray-700">
              <div class="flex items-center gap-1.5">
                <%= check_box_tag "user[remember_me]", "1", false, id: "user_remember_me", class: "w-3 h-3" %>
                <%= label_tag "user_remember_me", t("login_window.remember_me"), class: "cursor-pointer" %>
              </div>
              <div class="flex items-center gap-1.5 opacity-45">
                <%= check_box_tag "auto_sign_in", "1", false, id: "auto_sign_in", class: "w-3 h-3", disabled: true %>
                <%= label_tag "auto_sign_in", t("login_window.sign_in_automatically"), class: "cursor-default" %>
              </div>
            </div>

            <% if flash[:alert].present? %>
              <p class="text-[11px] text-red-600 mt-2"><%= flash[:alert] %></p>
            <% end %>

            <div class="flex items-center gap-2 mt-4">
              <%= submit_tag t("login_window.sign_in"),
                    class: "px-5 py-0.5 text-sm rounded border border-[#909090] bg-gradient-to-b from-[#f5f5f5] via-[#ebebeb] to-[#d8d8d8] shadow-[inset_0_1px_0_rgba(255,255,255,0.9)] hover:from-[#fafafa] hover:to-[#e0e0e0] active:shadow-[inset_1px_1px_3px_rgba(0,0,0,0.2)] cursor-pointer" %>
              <%= link_to t("login_window.cancel"), "#",
                    class: "px-5 py-0.5 text-sm rounded border border-[#909090] bg-gradient-to-b from-[#f5f5f5] via-[#ebebeb] to-[#d8d8d8] shadow-[inset_0_1px_0_rgba(255,255,255,0.9)] hover:from-[#fafafa] hover:to-[#e0e0e0] inline-block" %>
            </div>

            <p class="text-[12px] text-gray-600 mt-3">
              <%= t("login_window.no_account") %>
              <%= link_to t("login_window.sign_up_link"), new_user_registration_path, class: "text-[#1560c0] hover:underline" %>
            </p>

          <% end %>
        </div>
      </div>

    </div>

    <div class="relative flex items-center gap-6 mt-4 pb-4">
      <%= link_to t("login_window.privacy"), "#", class: "text-[11px] text-gray-500 hover:underline" %>
      <%= link_to t("login_window.terms"), "#", class: "text-[11px] text-gray-500 hover:underline" %>
      <%= link_to t("login_window.options"), "#", class: "text-[11px] text-gray-500 hover:underline" %>
    </div>

  </div>
<% end %>

<%= render WindowComponent.new(title: t("registration.window_title"), width: "490px") do %>
  <div class="relative bg-white px-6 pt-6">
    <div class="absolute inset-x-0 top-0 h-[110px] bg-gradient-to-b from-[#8bbad8] via-[#cce4f6] to-white pointer-events-none"></div>

    <span class="absolute top-3 right-3 w-6 h-6 rounded-full bg-gradient-to-b from-[#5aa0e8] to-[#3a78cc] text-white text-[12px] font-bold flex items-center justify-center cursor-default shadow-[inset_0_1px_0_rgba(255,255,255,0.4),0_1px_3px_rgba(0,0,0,0.3)] border border-[#2860aa]">?</span>

    <div class="relative">
      <div class="mb-5">
        <p class="text-[22px] text-[#2a4a7a] leading-snug"><%= t("registration.heading") %></p>
        <p class="text-[28px] font-bold text-[#1a3060] leading-snug"><%= t("registration.heading_bold") %></p>
      </div>

      <% if resource.errors.any? %>
        <div class="mb-3 text-[12px] text-red-600 space-y-0.5">
          <% resource.errors.full_messages.each do |msg| %>
            <p>• <%= msg %></p>
          <% end %>
        </div>
      <% end %>

      <%= form_with model: resource, url: registration_path(resource_name) do |f| %>
        <div class="mb-2">
          <%= f.label :username, t("registration.username"), class: "block text-[12px] text-gray-700 mb-0.5" %>
          <%= f.text_field :username,
                autocomplete: "username", required: true, autofocus: true,
                class: "w-full border border-[#a0a8b0] px-2 py-1 text-sm bg-white shadow-[inset_1px_1px_3px_rgba(0,0,0,0.15)] focus:outline-none focus:border-[#4a80c8]" %>
          <p class="text-[11px] text-gray-400 mt-0.5"><%= t("registration.username_hint") %></p>
        </div>

        <div class="mb-2">
          <%= f.label :email, t("registration.email"), class: "block text-[12px] text-gray-700 mb-0.5" %>
          <%= f.email_field :email,
                autocomplete: "email", required: true,
                class: "w-full border border-[#a0a8b0] px-2 py-1 text-sm bg-white shadow-[inset_1px_1px_3px_rgba(0,0,0,0.15)] focus:outline-none focus:border-[#4a80c8]" %>
        </div>

        <div class="mb-2">
          <%= f.label :password, t("registration.password"), class: "block text-[12px] text-gray-700 mb-0.5" %>
          <%= f.password_field :password,
                autocomplete: "new-password", required: true,
                class: "w-full border border-[#a0a8b0] px-2 py-1 text-sm bg-white shadow-[inset_1px_1px_3px_rgba(0,0,0,0.15)] focus:outline-none focus:border-[#4a80c8]" %>
          <% if @minimum_password_length %>
            <p class="text-[11px] text-gray-400 mt-0.5"><%= t("registration.password_hint", min: @minimum_password_length) %></p>
          <% end %>
        </div>

        <div class="mb-4">
          <%= f.label :password_confirmation, t("registration.password_confirmation"), class: "block text-[12px] text-gray-700 mb-0.5" %>
          <%= f.password_field :password_confirmation,
                autocomplete: "new-password", required: true,
                class: "w-full border border-[#a0a8b0] px-2 py-1 text-sm bg-white shadow-[inset_1px_1px_3px_rgba(0,0,0,0.15)] focus:outline-none focus:border-[#4a80c8]" %>
        </div>

        <div class="flex items-center gap-2">
          <%= f.submit t("registration.submit"),
                class: "px-5 py-0.5 text-sm rounded border border-[#909090] bg-gradient-to-b from-[#f5f5f5] via-[#ebebeb] to-[#d8d8d8] shadow-[inset_0_1px_0_rgba(255,255,255,0.9)] hover:from-[#fafafa] hover:to-[#e0e0e0] active:shadow-[inset_1px_1px_3px_rgba(0,0,0,0.2)] cursor-pointer" %>
          <%= link_to t("login_window.cancel"), root_path,
                class: "px-5 py-0.5 text-sm rounded border border-[#909090] bg-gradient-to-b from-[#f5f5f5] via-[#ebebeb] to-[#d8d8d8] shadow-[inset_0_1px_0_rgba(255,255,255,0.9)] hover:from-[#fafafa] hover:to-[#e0e0e0] inline-block" %>
        </div>

        <p class="text-[12px] text-gray-600 mt-3">
          <%= t("registration.already_registered") %>
          <%= link_to t("registration.sign_in_link"), new_user_session_path, class: "text-[#1560c0] hover:underline" %>
        </p>
      <% end %>
    </div>

    <div class="relative flex items-center gap-6 mt-4 pb-4">
      <%= link_to t("login_window.privacy"), "#", class: "text-[11px] text-gray-500 hover:underline" %>
      <%= link_to t("login_window.terms"), "#", class: "text-[11px] text-gray-500 hover:underline" %>
      <%= link_to t("login_window.options"), "#", class: "text-[11px] text-gray-500 hover:underline" %>
    </div>
  </div>
<% end %>
